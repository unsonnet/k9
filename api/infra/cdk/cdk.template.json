{
  "app": "uv run app.py",
  "context": {
    "<stage>": {
      "account": "<aws-account-id>",
      "region": "us-east-1",
      "lambdaArchitecture": "arm64",
      "shared": {
        "<param-group>": {
          "<ENV_VAR_NAME>": "<env-var-value>"
        }
      },
      "services": {
        "<service-name>": {
          "routePrefix": "/<route>",
          "dockerfile": "services/<service>/Dockerfile",
          "timeout": 20,
          "memory": 512,
          "shared": [
            "<param-group>"
          ],
          "environment": {
            "<ENV_VAR_NAME>": "<env-var-value>"
          },
          "readableParameterNames": []
        }
      }
    }
  }
}