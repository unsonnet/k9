{
  "app": "uv run app.py",
  "context": {
    "<stage>": {
      "account": "<aws-account-id>",
      "region": "us-east-1",
      "architecture": "arm64",
      "shared": {
        "<param-group>": {
          "<ENV_VAR_NAME>": "<env-var-value>"
        }
      },
      "services": {
        "<service-name>": {
          "routePrefix": "/<route>",
          "dockerfile": "services/<service-name>/Dockerfile",
          "timeout": 20,
          "memory": 512,
          "shared": [
            "<param-group>"
          ],
          "environment": {
            "<ENV_VAR_NAME>": "<env-var-value>"
          }
        }
      },
      "workers": {
        "<worker-name>": {
          "dockerfile": "workers/<worker-name>/Dockerfile",
          "timeout": 20,
          "memory": 512,
          "shared": [
            "<param-group>"
          ],
          "environment": {
            "<ENV_VAR_NAME>": "<env-var-value>"
          },
          "tableName": "<dynamodb-table-name>",
          "streamArnParameter": "<ssm-parameter-for-stream-arn>",
          "batchSize": 50,
          "retryAttempts": 10,
          "reportBatchItemFailures": true,
          "bisectBatchOnError": true,
          "maxRecordAgeSeconds": null,
          "maxBatchingWindowSeconds": null,
          "parallelizationFactor": null,
          "opensearchCollectionArnParameter": null
        }
      }
    }
  }
}