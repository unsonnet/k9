{
  "app": "uv run app.py",
  "context": {
    "<stage>": {
      "account": "<aws-account-id>",
      "region": "us-east-1",
      "architecture": "arm64",
      "shared": {
        "<param-group>": {
          "<ENV_VAR_NAME>": "<env-var-value>"
        }
      },
      "services": {
        "<service-name>": {
          "timeout": 20,
          "memory": 512,
          "shared": [
            "<param-group>"
          ],
          "environment": {
            "<ENV_VAR_NAME>": "<env-var-value>"
          }
        }
      },
      "workers": {
        "<dynamodb-worker-name>": {
          "source": "dynamodb",
          "timeout": 20,
          "memory": 512,
          "shared": [
            "<param-group>"
          ],
          "environment": {
            "<ENV_VAR_NAME>": "<env-var-value>"
          },
          "tableName": "<dynamodb-table-name>",
          "streamArnParameter": "<ssm-parameter-for-stream-arn>",
          "bucketName": "<s3-bucket-name>",
          "batchSize": 50,
          "retryAttempts": 10,
          "reportBatchItemFailures": true,
          "bisectBatchOnError": true,
          "maxRecordAgeSeconds": null,
          "maxBatchingWindowSeconds": null,
          "parallelizationFactor": null,
          "opensearchCollectionArnParameter": null
        },
        "<s3-worker-name>": {
          "source": "s3",
          "timeout": 20,
          "memory": 512,
          "shared": [
            "<param-group>"
          ],
          "environment": {
            "<ENV_VAR_NAME>": "<env-var-value>"
          },
          "bucketName": "<s3-bucket-name>",
          "opensearchCollectionArnParameter": null
        }
      }
    }
  }
}